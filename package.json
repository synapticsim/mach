{
    "name": "@synaptic-simulations/mach",
    "version": "1.3.0-rc9",
    "description": "The last MSFS instrument bundler you'll ever need.",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "mach": "./dist/index.js"
    },
    "scripts": {
        "build": "tsc && copyfiles --flat src/templates/* dist/templates",
        "watch": "nodemon --watch src/index.ts --watch src --ext * --exec \"yarn build || exit 1\"",
        "lint": "biome check",
        "lint:fix": "biome check --fix --unsafe"
    },
    "keywords": [
        "msfs",
        "bundler",
        "esbuild"
    ],
    "author": "Michael Romashov <mromashov@icloud.com>",
    "repository": "https://github.com/synapticsim/mach.git",
    "license": "MIT",
    "dependencies": {
        "chalk": "^6.0.1",
        "chokidar": "^5.0.0",
        "commander": "^15.0.0",
        "dotenv": "^18.0.7",
        "esbuild": "^0.28.2",
        "filesize": "^11.0.25",
        "import-single-ts": "^1.2.1",
        "signale": "^1.4.0",
        "template-file": "^6.0.1",
        "zod": "^4.6.5",
        "zod-validation-error": "5.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@types/node": "^26.6.5",
        "@types/signale": "^1.4.7",
        "copyfiles": "^2.4.1",
        "nodemon": "^3.1.14",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
